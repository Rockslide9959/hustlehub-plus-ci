# Copy this file to .env and fill in real values.
# Never commit the real .env file: it contains secrets.

PORT=4000
APP_NAME=HustleHub+
NODE_ENV=development

# MongoDB Atlas connection string (ask the team for the real one)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/HustleHub?appName=Cluster0

# Frontend origin allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Optional: DNS servers to use, comma separated. Only needed if connecting to
# MongoDB Atlas fails with a "querySrv" error (seen on some Windows setups).
# DNS_SERVERS=8.8.8.8,8.8.4.4

# HTTPS (self-signed development certificate)
USE_HTTPS=true
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost-cert.pem

# JWT signing secret: use a long random value, e.g. generate one with
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<long_random_secret>
JWT_EXPIRES_IN=1h

# Password used by npm run create-admin
ADMIN_PASSWORD=<strong_admin_password>

# Optional rate limits (defaults shown). Raise them only for local testing.
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_REGISTER_MAX=10
# RATE_LIMIT_BOOKING_MAX=5
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_2FA_MAX=10

# Account lockout with progressive delay (defaults shown).
# After LOCKOUT_MAX_ATTEMPTS wrong passwords or 2FA codes in a row, the account
# is locked for LOCKOUT_BASE_MINUTES. Each new lock doubles in length, up to
# LOCKOUT_MAX_MINUTES. Failures older than LOCKOUT_RESET_MINUTES are forgotten.
# LOCKOUT_MAX_ATTEMPTS=5
# LOCKOUT_BASE_MINUTES=15
# LOCKOUT_MAX_MINUTES=240
# LOCKOUT_RESET_MINUTES=15

# Two-factor authentication: key that encrypts 2FA secrets in the database
# (AES-256-GCM). Must be 64 hex characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, a separate key is derived from JWT_SECRET instead, but a
# dedicated key is recommended. Never change it once users have 2FA on, or
# their saved secrets can no longer be read.
TWO_FACTOR_ENCRYPTION_KEY=<64_hex_character_key>
